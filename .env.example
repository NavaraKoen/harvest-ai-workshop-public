# LLM provider: "ollama" (default), "openai", or "anthropic"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI settings (used when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Anthropic settings (used when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MAX_TOKENS=4096

# Temporal settings
TEMPORAL_HOST=localhost:7233

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Base URL the Temporal worker uses to reach the services endpoints
# Defaults to the same process as the API (http://localhost:8000)
SERVICES_BASE_URL=http://localhost:8000

# If false, tools are executed immediately without waiting for user confirmation
CONFIRMATION=true

# If true, log every LLM request and response to the worker stdout
LOG_LLM_CALLS=false

# Spotify app credentials (client-credentials flow; no personal listening history needed)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=NL

# Invite the Slack bot to this channel. Bot scope: chat:write.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Slack Events API request verification; subscribe to message.channels / message.groups
SLACK_SIGNING_SECRET=
